# =============================================================================
# Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
# Lines starting with # are comments and will be ignored.
#
# REQUIRED variables will cause the app to fail on startup if missing.
# OPTIONAL variables have sensible defaults or are only needed for specific features.
# =============================================================================

# ─── Server ───────────────────────────────────────────────────────────────────
# OPTIONAL - Default: 8000
PORT=8000

# ─── Database ─────────────────────────────────────────────────────────────────
# REQUIRED - MongoDB connection string (without database name)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority

# ─── Authentication (JWT) ────────────────────────────────────────────────────
# REQUIRED - Secret key for signing access tokens (use a long random string)
ACCESS_TOKEN_SECRET=
# OPTIONAL - Default: 1d
ACCESS_TOKEN_EXPIRY=1d
# REQUIRED - Secret key for signing refresh tokens (use a long random string)
REFRESH_TOKEN_SECRET=
# OPTIONAL - Default: 10d
REFRESH_TOKEN_EXPIRY=10d

# ─── Cloudinary (Media Uploads) ──────────────────────────────────────────────
# OPTIONAL - Required only for image/video upload features
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── SMTP / Email ────────────────────────────────────────────────────────────
# OPTIONAL - Required only for email features (password reset OTP, etc.)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SENDER_EMAIL=

# ─── App ─────────────────────────────────────────────────────────────────────
# OPTIONAL - Default: production
# Accepted values: development | production | test
NODE_ENV=production
# OPTIONAL - Default: info
LOG_LEVEL=info
