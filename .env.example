# =============================================================================
# Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
# Lines starting with # are comments and will be ignored.
#
# REQUIRED variables will cause the app to fail on startup if missing.
# OPTIONAL variables have sensible defaults or are only needed for specific features.
# =============================================================================

# ─── Server ───────────────────────────────────────────────────────────────────
# OPTIONAL - Default: 8000
PORT=8000

# ─── Database ─────────────────────────────────────────────────────────────────
# REQUIRED outside Docker. Docker generates an internal URI from the MongoDB
# credentials below, so this value is overridden for the backend container.
# For local/Atlas: mongodb+srv://username:password@cluster.mongodb.net/
# For Docker:      overridden by docker-entrypoint.sh automatically
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority

# ─── Authentication (JWT) ────────────────────────────────────────────────────
# REQUIRED - Secret key for signing access tokens (use a long random string)
ACCESS_TOKEN_SECRET=
# OPTIONAL - Default: 1d
ACCESS_TOKEN_EXPIRY=1d
# REQUIRED - Secret key for signing refresh tokens (use a long random string)
REFRESH_TOKEN_SECRET=
# OPTIONAL - Default: 10d
REFRESH_TOKEN_EXPIRY=10d

# ─── Cloudinary (Media Uploads) ──────────────────────────────────────────────
# OPTIONAL - Required only for image/video upload features
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── SMTP / Email ────────────────────────────────────────────────────────────
# OPTIONAL - Required only for email features (password reset OTP, etc.)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SENDER_EMAIL=

# ─── App ─────────────────────────────────────────────────────────────────────
# OPTIONAL - Default: production
# Accepted values: development | production | test
NODE_ENV=production
# OPTIONAL - Default: info
LOG_LEVEL=info

# ─── Docker / MongoDB ────────────────────────────────────────────────────────
# Used by docker-compose.yml for MongoDB container initialization.
# These are ONLY needed when running with Docker.
MONGO_INITDB_ROOT_USERNAME=replace-with-a-dedicated-admin-username
MONGO_INITDB_ROOT_PASSWORD=replace-with-a-long-random-password
MONGO_INITDB_DATABASE=youtube
